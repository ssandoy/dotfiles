[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-k": "git::Commit",
      "ctrl-alt-k": "git::PushTo",
      "ctrl-t": "git::Pull",
      "ctrl-f4": "pane::CloseActiveItem",
      "ctrl-w": "pane::CloseActiveItem",
      "shift-ctrl-n": "file_finder::Toggle",
      "ctrl-shift-o": "file_finder::Toggle",
      "ctrl-alt-left": "pane::GoBack",
      "ctrl-alt-right": "pane::GoForward",
      "alt-5": "debug_panel::Toggle",
      "shift-alt-f9": "debug_panel::Toggle",
      "shift-ctrl-f8": "debug_panel::Toggle",
      "ctrl-f9": "task::Spawn",
      "shift-f10": "task::Rerun",
      "shift-ctrl-c": "workspace::CopyPath",
      "shift-f9": "debugger::Start",
      "f9": "debugger::Continue",
      "ctrl-f8": "editor::ToggleBreakpoint",
      "alt-insert": "workspace::NewFile",
      "shift-ctrl-alt-insert": "workspace::NewFile",
      "shift-ctrl-a": "command_palette::Toggle",
      "shift shift": "command_palette::Toggle",
      "ctrl-n": "project_symbols::Toggle",
      "ctrl-g": "go_to_line::Toggle",
      "shift-escape": "workspace::ToggleLeftDock",
      "shift-ctrl-f12": "workspace::ToggleZoom",
      "alt-right": "pane::ActivateNextItem",
      "alt-left": "pane::ActivatePreviousItem",
      "ctrl-e": "projects::OpenRecent",
      "ctrl-s": "workspace::SaveAll",
      "ctrl-alt-s": "zed::OpenSettings",
      "shift-ctrl-alt-s": "zed::OpenProjectTasks",
      "ctrl-`": "theme_selector::Toggle",
      "shift-ctrl-f": "pane::DeploySearch",
      "shift-ctrl-r": [
        "pane::DeploySearch",
        {
          "replace_enabled": true
        }
      ]
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-z": "editor::Undo",
      "shift-ctrl-z": "editor::Redo",
      "shift-alt-backspace": "editor::Redo",
      "ctrl-y": "editor::DeleteLine",
      "alt-backspace": "editor::DeleteLine",
      "f2": "editor::GoToDiagnostic",
      "ctrl-alt-e": "editor::GoToDiagnostic",
      "shift-f2": "editor::GoToPreviousDiagnostic",
      "shift-f6": "editor::Rename",
      "ctrl-alt-r": "editor::Rename",
      "ctrl-c": "editor::Copy",
      "ctrl-insert": "editor::Copy",
      "ctrl-x": "editor::Cut",
      "shift-delete": "editor::Cut",
      "ctrl-v": "editor::Paste",
      "shift-insert": "editor::Paste",
      "ctrl-space": "editor::ShowCompletions",
      "shift-ctrl-enter": "editor::ConfirmCompletion",
      "ctrl--": "editor::Fold",
      "shift-ctrl--": "editor::FoldAll",
      "ctrl-alt--": "editor::FoldRecursive",
      "ctrl-=": "editor::UnfoldLines",
      "shift-ctrl-=": "editor::UnfoldAll",
      "ctrl-alt-=": "editor::UnfoldRecursive",
      "ctrl-/": "editor::ToggleComments",
      "ctrl-?": "editor::ToggleBlockComments",
      "ctrl-d": "editor::DuplicateLineDown",
      "f4": "editor::GoToDeclaration",
      "ctrl-delete": "editor::DeleteToNextWordEnd",
      "ctrl-backspace": "editor::DeleteToPreviousWordStart",
      "shift-ctrl-j": "editor::JoinLines",
      "end": "editor::MoveToEndOfLine",
      "shift-end": "editor::SelectToEndOfLine",
      "home": "editor::MoveToBeginningOfLine",
      "shift-home": "editor::SelectToBeginningOfLine",
      "ctrl-pagedown": "editor::SelectToEnd",
      "shift-ctrl-pagedown": "editor::SelectToEnd",
      "ctrl-pageup": "editor::SelectToBeginning",
      "shift-ctrl-pageup": "editor::SelectToBeginning",
      "ctrl-right": "editor::MoveToNextWordEnd",
      "shift-ctrl-right": "editor::SelectToNextWordEnd",
      "ctrl-left": "editor::MoveToPreviousWordStart",
      "shift-ctrl-left": "editor::SelectToPreviousWordStart",
      "pageup": "editor::MovePageUp",
      "shift-pageup": "editor::SelectPageUp",
      "pagedown": "editor::MovePageDown",
      "shift-pagedown": "editor::SelectPageDown",
      "ctrl-w": "editor::SelectLargerSyntaxNode",
      "shift-ctrl-w": "editor::SelectSmallerSyntaxNode",
      "ctrl-enter": "editor::NewlineBelow",
      "shift-enter": "editor::NewlineBelow",
      "ctrl-alt-enter": "editor::NewlineAbove",
      "shift-ctrl-alt-up": "editor::GoToPreviousHunk",
      "shift-alt-down": "editor::MoveLineDown",
      "shift-alt-up": "editor::MoveLineUp",
      "ctrl-alt-o": "editor::OrganizeImports",
      "ctrl-p": "editor::ShowSignatureHelp",
      "shift-ctrl-i": "editor::GoToDeclaration",
      "ctrl-q": "editor::Hover",
      "ctrl-alt-l": "editor::Format",
      "ctrl-r": "buffer_search::DeployReplace",
      "shift-ctrl-alt-j": "editor::SelectAllMatches",
      "alt-j": "editor::SelectNext",
      "ctrl-f1": "editor::ToggleDiagnostics",
      "alt-enter": "editor::ToggleCodeActions",
      "ctrl-alt-f7": "editor::FindAllReferences",
      "alt-f7": "editor::FindAllReferences",
      "ctrl-alt-b": "editor::GoToImplementation",
      "shift-ctrl-b": "editor::GoToTypeDefinition",
      "ctrl-f12": "outline_panel::Toggle",
      "shift-ctrl-alt-n": "outline_panel::Toggle",
      "f3": "search::SelectNextMatch",
      "ctrl-l": "search::SelectNextMatch",
      "shift-f3": "search::SelectPreviousMatch",
      "shift-ctrl-l": "search::SelectPreviousMatch",
      "ctrl-alt-z": "git::Restore"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-c": [
        "terminal::SendKeystroke",
        "ctrl-c"
      ],
      "ctrl-v": "terminal::Paste",
      "shift-insert": "terminal::Paste"
    }
  }
]
