# Fyk-Konsulenter CLIs (tripletex-cli etc.) live on GitHub Packages, not npmjs.
# NODE_AUTH_TOKEN is exported from `gh auth token` (zsh/lazy/56-npm-auth.zsh);
# the gh login needs the read:packages scope.
@fyk-konsulenter:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
