#!/usr/bin/env bash
set -euo pipefail

SESSION_FORMAT="#{session_last_attached}	#{session_name}"
CURRENT_SESSION=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
BORDER_LABEL=" Session Browser"

if [[ -n "${CURRENT_SESSION}" ]]; then
    BORDER_LABEL="${BORDER_LABEL}: ${CURRENT_SESSION}"
fi

BORDER_LABEL="${BORDER_LABEL} "

if [[ "${1-}" == "--popup" ]]; then
    popup_args=(-w 70% -h 40% -E)

    if [[ -n "${2-}" ]]; then
        popup_args=(-c "$2" "${popup_args[@]}")
    fi

    tmux popup "${popup_args[@]}" "$HOME/.config/tmux/tmux-session-browser"
    exit 0
fi

if ! sessions=$(tmux list-sessions -F "${SESSION_FORMAT}" 2>/dev/null); then
    exit 0
fi

if [[ -z "${sessions}" ]]; then
    exit 0
fi

sessions=$(
    printf "%s\n" "${sessions}" |
        awk -F '\t' -v current="${CURRENT_SESSION}" '$2 != current' |
        sort -rn -k1,1 |
        cut -f2-
)

if [[ -z "${sessions}" ]]; then
    exit 0
fi

selected=$(
    printf "%s\n" "${sessions}" | fzf \
        --prompt 'session > ' \
        --layout=reverse \
        --border=rounded \
        --border-label "${BORDER_LABEL}" \
        --border-label-pos=2 \
        --header 'tab/btab: move | enter: switch | esc: cancel' \
        --header-first \
        --info=inline-right \
        --padding=1,2 \
        --highlight-line \
        --pointer='>' \
        --no-scrollbar \
        --ellipsis='...' \
        --color='bg:-1,bg+:#313244,fg:#cdd6f4,fg+:#f5e0dc,hl:#f38ba8,hl+:#f38ba8,prompt:#cba6f7,pointer:#f5c2e7,marker:#a6e3a1,spinner:#f9e2af,info:#89b4fa,border:#45475a,label:#cba6f7,header:#7f849c' \
        --no-sort \
        --cycle \
        --bind 'tab:down,btab:up' \
        --exit-0
) || exit 0

if [[ -z "${selected}" ]]; then
    exit 0
fi

session_name="${selected}"

if [[ -n "${TMUX-}" ]]; then
    tmux switch-client -t "${session_name}"
else
    tmux attach -t "${session_name}"
fi
