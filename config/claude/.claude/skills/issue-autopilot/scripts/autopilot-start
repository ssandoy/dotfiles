#!/usr/bin/env bash
# Usage: autopilot-start <config>
# Runs the watcher in an "Autopilot" tab of the current herdr workspace
# (HERDR_WORKSPACE_ID) so it always lives where autopilot was started. Only
# when run outside herdr does it fall back to the repo's workspace (matched by
# checkout path, then label), creating one for ROOT if none match.
set -euo pipefail
source "$(dirname "$0")/autopilot-lib" "$1"

ws=${HERDR_WORKSPACE_ID:-}
if [[ -z "$ws" ]]; then
    ws=$(herdr workspace list | jq -r --arg r "$ROOT" --arg l "$(basename "$ROOT")" '
        [.result.workspaces[] | select(.worktree.checkout_path==$r)] +
        [.result.workspaces[] | select(.worktree==null and .label==$l)]
        | .[0].workspace_id // empty')
fi
if [[ -z "$ws" ]]; then
    ws=$(herdr workspace create --cwd "$ROOT" --no-focus | jq -r '.result.workspace.workspace_id')
fi

if herdr tab list --workspace "$ws" | jq -e '.result.tabs[] | select(.label=="Autopilot")' >/dev/null; then
    echo "already running in workspace $ws (Autopilot tab)"
    exit 0
fi
pane=$(herdr tab create --workspace "$ws" --cwd "$ROOT" --label Autopilot --no-focus | jq -r '.result.root_pane.pane_id')
herdr pane run "$pane" "$scripts_dir/autopilot-watcher" "$(realpath "$1")" "$pane" >/dev/null
echo "watcher started in workspace $ws, Autopilot tab (pane $pane)"
