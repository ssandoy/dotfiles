#!/usr/bin/env bash
# Usage: tests/run — runs every tests/test-*.sh, prints ok/FAIL per file.
set -uo pipefail
cd "$(dirname "$0")" || exit 1
failed=0
for t in test-*.sh; do
    if out=$(bash "$t" 2>&1); then
        echo "ok   $t"
    else
        echo "FAIL $t"
        sed 's/^/    /' <<<"$out"
        failed=1
    fi
done
exit "$failed"
