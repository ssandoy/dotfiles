{
  "permissions": {
    "allow": [
      "Bash(git push:*)"
    ]
  },
  "attribution": {
    "commit": ""
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/agent-notify\" \"Claude Code\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/sander.sandoy/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "tripletex-plugin@fyk-plugin-marketplace": true,
    "regnskapsloven-plugin@fyk-plugin-marketplace": true,
    "supabase-db-plugin@fyk-plugin-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "browser-flow-plugin@fyk-plugin-marketplace": true,
    "grafana-plugin@fyk-plugin-marketplace": true,
    "nrs8-accounting-plugin@fyk-plugin-marketplace": true,
    "notion-plugin@fyk-plugin-marketplace": true
  },
  "extraKnownMarketplaces": {
    "fyk-plugin-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:Fyk-Konsulenter/fyk-plugin-marketplace.git"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "preferredNotifChannel": "notifications_disabled",
  "voiceEnabled": true
}
