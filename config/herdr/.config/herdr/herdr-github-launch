#!/usr/bin/env bash
# Runs gh-dash for the "github" workspace pane, alongside a background poller
# that reports a live "N to review" badge via herdr's agent-status API — the
# same mechanism herdr uses to show coding-agent working/blocked state in its
# sidebar, reused here so the review count is visible without opening the tab.
#
# Deliberately not `exec gh-dash`: exec'ing would replace this shell, and the
# EXIT trap below (which kills the poller) would then never fire since the
# shell it's attached to no longer exists. Running gh-dash as a normal
# foreground command keeps this script alive to clean up after it exits.
set -euo pipefail

pane_id="${1:?pane_id required}"
source="custom:github-badge"
agent="needs-review"

source "$HOME/.config/herdr/herdr-github-common"

poll() {
    # ids we've already fired a notification for this run — keeps a PR that
    # stays unread from re-notifying every 60s until it's marked seen (see
    # herdr-github, which marks-seen on focus).
    local notified_ids=""
    while true; do
        json=$(needs_review)
        count=$(jq -r '.issueCount' <<<"$json")
        ids=$(jq -r '.ids[]' <<<"$json")

        unread=$(unread_ids "$ids")
        unread_count=0
        [[ -n "$unread" ]] && unread_count=$(wc -l <<<"$unread")

        # The dot/blocked-state reflects *unread* PRs, not just pending ones
        # — a PR you've already looked at (workspace was focused since it
        # appeared) stays out of the badge state even while still pending.
        if [[ "$unread_count" -gt 0 ]]; then
            herdr pane report-agent "$pane_id" --source "$source" --agent "$agent" --state blocked
        else
            herdr pane report-agent "$pane_id" --source "$source" --agent "$agent" --state idle
        fi
        herdr pane report-metadata "$pane_id" --source "$source" --agent "$agent" \
            --display-agent "${count} to review"

        new_unread=$(comm -23 \
            <(printf '%s\n' "$unread" | grep -v '^$' | sort -u) \
            <(printf '%s\n' "$notified_ids" | grep -v '^$' | sort -u))
        if [[ -n "$new_unread" ]]; then
            new_count=$(wc -l <<<"$new_unread")
            # herdr's own "system" toast delivery shells out to notify-send,
            # which needs a D-Bus org.freedesktop.Notifications daemon —
            # WSLg's X11 compositor never maps such a daemon's popup windows
            # (confirmed: dunst's window stays unmapped no matter how it's
            # configured), so it silently renders nothing on WSL. wsl-toast
            # goes straight through Windows' own toast API instead and
            # actually works there; elsewhere herdr's own path is fine.
            # Absolute path, not a PATH lookup: this pane's poll() runs
            # under a bare bash (see herdr pane run above), which doesn't
            # carry the interactive shell's PATH additions like ~/.local/bin.
            wsl_toast="$HOME/.local/bin/wsl-toast"
            if [[ -n "${WSL_DISTRO_NAME:-}" && -x "$wsl_toast" ]]; then
                "$wsl_toast" "New PR to review" "${new_count} new PR(s) awaiting your review"
            else
                herdr notification show "New PR to review" \
                    --body "${new_count} new PR(s) awaiting your review" \
                    --sound request
            fi
            notified_ids=$(printf '%s\n%s\n' "$notified_ids" "$new_unread" | grep -v '^$' | sort -u)
        fi
        sleep 60
    done
}

# Redirected as a whole: poll() shares this pane's tty since it isn't run in
# a separate pane, so any stray stdout/stderr from the commands it runs (a
# JSON confirmation line from `notification show`, a mise/yq/gh warning,
# anything) would otherwise print straight onto gh-dash's screen and corrupt
# the TUI render — this actually happened during development.
poll >/dev/null 2>&1 &
poll_pid=$!
trap 'kill "$poll_pid" 2>/dev/null' EXIT

# gh-dash's "open in GitHub" uses GH_BROWSER (same lookup gh itself uses).
# herdr's own server process is long-lived and may have inherited a stale
# wsl-browser path from before it moved (see 22-gh.zsh) — re-derive it here
# so this pane isn't stuck with whatever the server had at its own startup.
if [[ -n "${WSL_DISTRO_NAME:-}" ]] \
    && { [[ -z "${GH_BROWSER:-}" ]] || [[ "${GH_BROWSER:-}" == */wsl-browser && ! -x "${GH_BROWSER:-}" ]]; } \
    && command -v wsl-browser >/dev/null 2>&1; then
    export GH_BROWSER=wsl-browser
fi

gh-dash
