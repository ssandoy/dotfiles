#!/usr/bin/env bash
# Runs gh-dash for the "github" workspace pane, alongside a background poller
# that reports a live "N to review" badge via herdr's agent-status API — the
# same mechanism herdr uses to show coding-agent working/blocked state in its
# sidebar, reused here so the review count is visible without opening the tab.
#
# Deliberately not `exec gh-dash`: exec'ing would replace this shell, and the
# EXIT trap below (which kills the poller) would then never fire since the
# shell it's attached to no longer exists. Running gh-dash as a normal
# foreground command keeps this script alive to clean up after it exits.
set -euo pipefail

pane_id="${1:?pane_id required}"
source="custom:github-badge"
agent="needs-review"

gh_dash_config="$HOME/.config/gh-dash/config.yml"

# Reads the "Needs My Review" section's filters straight from gh-dash's own
# config every poll, so the badge count always matches the tab count instead
# of drifting from a second hardcoded copy of the same query (which is
# exactly what happened before: this used to hardcode a plain
# review-requested:@me query with none of the repo exclusions from
# config.yml, so the badge and the tab silently disagreed).
count_needs_review() {
    local filters query
    filters=$(yq -r '.prSections[] | select(.title == "Needs My Review") | .filters' "$gh_dash_config" 2>/dev/null)
    if [[ -z "$filters" || "$filters" == "null" ]]; then
        echo 0
        return
    fi
    # gh-dash always adds is:pr and archived:false to a section's filters —
    # match that here so the query is equivalent, not just visually similar.
    query="is:pr archived:false $filters"
    gh api graphql \
        -f query='query($q: String!) { search(type: ISSUE, query: $q, first: 1) { issueCount } }' \
        -f q="$query" \
        -q '.data.search.issueCount' 2>/dev/null || echo 0
}

poll() {
    local prev_count=-1
    while true; do
        count=$(count_needs_review)
        if [[ "$count" -gt 0 ]]; then
            herdr pane report-agent "$pane_id" --source "$source" --agent "$agent" --state blocked
        else
            herdr pane report-agent "$pane_id" --source "$source" --agent "$agent" --state idle
        fi
        herdr pane report-metadata "$pane_id" --source "$source" --agent "$agent" \
            --display-agent "${count} to review"
        # Only notify when the count *rises* (new PR(s) showed up), not on
        # every poll it stays nonzero — and not on the first poll (prev_count
        # -1), so relaunching this script doesn't re-notify for PRs already
        # sitting in the queue.
        if [[ "$prev_count" -ge 0 && "$count" -gt "$prev_count" ]]; then
            herdr notification show "New PR to review" \
                --body "${count} PR(s) awaiting your review" \
                --sound request
        fi
        prev_count="$count"
        sleep 60
    done
}

poll &
poll_pid=$!
trap 'kill "$poll_pid" 2>/dev/null' EXIT

# gh-dash's "open in GitHub" uses GH_BROWSER (same lookup gh itself uses).
# herdr's own server process is long-lived and may have inherited a stale
# wsl-browser path from before it moved (see 22-gh.zsh) — re-derive it here
# so this pane isn't stuck with whatever the server had at its own startup.
if [[ -n "${WSL_DISTRO_NAME:-}" ]] \
    && { [[ -z "${GH_BROWSER:-}" ]] || [[ "${GH_BROWSER:-}" == */wsl-browser && ! -x "${GH_BROWSER:-}" ]]; } \
    && command -v wsl-browser >/dev/null 2>&1; then
    export GH_BROWSER=wsl-browser
fi

gh-dash
