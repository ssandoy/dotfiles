#!/usr/bin/env bash
# Open (or focus) a "Run" tab in the current workspace: a plain login shell
# for running local processes/apps for this workspace, separate from the
# Agents and Diff tabs.
set -euo pipefail

current=$(herdr pane current --current)
workspace_id=$(jq -r '.result.pane.workspace_id' <<<"$current")
cwd=$(jq -r '.result.pane.cwd' <<<"$current")

label="Run"

existing_tab_id=$(
    herdr tab list --workspace "$workspace_id" |
        jq -r --arg label "$label" \
            '.result.tabs[] | select(.label == $label) | .tab_id' |
        head -n1
)

if [[ -n "$existing_tab_id" ]]; then
    herdr tab focus "$existing_tab_id"
    exit 0
fi

herdr tab create --workspace "$workspace_id" --cwd "$cwd" --label "$label" --focus >/dev/null
# No explicit shell launch: a freshly created tab's root pane already starts
# with a live default shell, so running one would just be typed into it as
# a redundant nested shell.
