#!/usr/bin/env bash
# herdr equivalent of the old tmux-sessionizer: pick a project dir with fzf,
# then focus its herdr workspace if one already exists for it, or create one.
set -euo pipefail

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
        {
            find ~/git -mindepth 1 -maxdepth 1 -type d -not -path '*/.*'
            echo ~/dotfiles
        } |
            awk -F/ '{printf "\033[1m%s\033[0m\t%s\n", $NF, $0}' |
            fzf \
                --ansi \
                --delimiter='\t' \
                --with-nth=1 \
                --prompt='projects > ' \
                --layout=reverse \
                --border=rounded \
                --border-label=' herdr sessionizer ' \
                --header='enter: switch/create | esc: cancel' \
                --header-first \
                --info=inline-right \
                --preview='printf "\n  %s\n" {2}' \
                --preview-window='down,3,border-top' \
                --preview-label=' path ' \
                --no-scrollbar \
                --cycle \
                --color='bg:-1,bg+:#313244,fg:#cdd6f4,fg+:#f5e0dc,hl:#f38ba8,hl+:#f38ba8,prompt:#cba6f7,pointer:#f5c2e7,marker:#a6e3a1,spinner:#f9e2af,info:#89b4fa,border:#45475a,label:#cba6f7,header:#7f849c' |
            cut -f2-
    )
fi

if [[ -z "${selected:-}" ]]; then
    exit 0
fi

label=$(basename "$selected" | tr . _)

existing_id=$(
    herdr workspace list |
        jq -r --arg label "$label" \
            '.result.workspaces[] | select(.label == $label) | .workspace_id' |
        head -n1
)

if [[ -n "$existing_id" ]]; then
    herdr workspace focus "$existing_id"
else
    created=$(herdr workspace create --cwd "$selected" --label "$label" --focus)
    workspace_id=$(jq -r '.result.workspace.workspace_id' <<<"$created")
    agents_tab_id=$(jq -r '.result.tab.tab_id' <<<"$created")
    herdr tab rename "$agents_tab_id" "Agents"

    # Pair it with a Diff tab (see herdr-diff-tab) up front rather than
    # waiting for prefix+alt+d on first use — --no-focus keeps you landed
    # on Agents, which is what you actually want right after creating a
    # workspace.
    diff_created=$(herdr tab create --workspace "$workspace_id" --cwd "$selected" --label "Diff" --no-focus)
    diff_pane_id=$(jq -r '.result.root_pane.pane_id' <<<"$diff_created")
    herdr pane run "$diff_pane_id" hunk diff --theme catppuccin-mocha --watch
    # hunk's file sidebar defaults closed with no flag to change that, so
    # toggle it on with its own "s" keybinding once it's had a moment to
    # render.
    sleep 0.5
    herdr pane send-keys "$diff_pane_id" s
fi
