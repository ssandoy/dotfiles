#!/usr/bin/env bash
# Collect the human review notes left in the workspace's "Diff" tab (via
# hunk's own "c" / create-review-note key) and send them back to whichever
# agent pane originally opened that tab (stamped there by herdr-diff-tab).
set -euo pipefail

log_file="$HOME/.cache/herdr/herdr-diff-send-comments.log"
mkdir -p "$(dirname "$log_file")"
exec 2>>"$log_file"

# type=pane commands run detached with no visible terminal, so a silent
# failure here (e.g. herdr agent prompt rejecting a busy/blocked target)
# would otherwise vanish with no feedback at all. Surface it as a toast
# and leave the real error in $log_file (stderr is appended there above).
on_error() {
    local line=$1 rc=$2
    echo "$(date -Is) failed at line $line (exit $rc)" >>"$log_file"
    herdr notification show "Sending comments failed" --body "See ~/.cache/herdr/herdr-diff-send-comments.log"
}
trap 'on_error $LINENO $?' ERR

current=$(herdr pane current --current)
workspace_id=$(jq -r '.result.pane.workspace_id' <<<"$current")

label="Diff"

diff_tab_id=$(
    herdr tab list --workspace "$workspace_id" |
        jq -r --arg label "$label" \
            '.result.tabs[] | select(.label == $label) | .tab_id' |
        head -n1
)

if [[ -z "$diff_tab_id" ]]; then
    herdr notification show "No Diff tab open" --body "Open one first with prefix+alt+d."
    exit 0
fi

diff_pane_id=$(
    herdr pane list --workspace "$workspace_id" |
        jq -r --arg tab_id "$diff_tab_id" \
            '.result.panes[] | select(.tab_id == $tab_id) | .pane_id' |
        head -n1
)

diff_pane=$(herdr pane get "$diff_pane_id")
cwd=$(jq -r '.result.pane.cwd' <<<"$diff_pane")
origin_pane_id=$(jq -r '.result.pane.tokens.origin_pane // empty' <<<"$diff_pane")

if [[ -z "$origin_pane_id" ]]; then
    herdr notification show "No origin conversation recorded" --body "Reopen the Diff tab with prefix+alt+d, then try again."
    exit 0
fi

comments_json=$(hunk session comment list --repo "$cwd" --type user --json)
count=$(jq -r '.comments | length' <<<"$comments_json")

if [[ "$count" -eq 0 ]]; then
    herdr notification show "No comments to send" --body "Leave one with 'c' in the Diff tab first."
    exit 0
fi

repo_name=$(basename "$cwd")

# newRange/oldRange are two-element [start, end] arrays; a comment is always
# anchored to one side or the other, never neither.
body=$(
    jq -r '.comments[] | "\(.filePath):\((.newRange // .oldRange)[0])\n\(.body)\n"' \
        <<<"$comments_json"
)
message="Review notes from the Diff tab ($repo_name):"$'\n\n'"$body"

# Captured now so the exact set of notes that went into $message is what gets
# removed below — not "whatever hunk reports after sending" (a note added
# mid-send would otherwise get silently swept up too).
mapfile -t note_ids < <(jq -r '.comments[].noteId' <<<"$comments_json")

if ! herdr agent prompt "$origin_pane_id" "$message" 2>>"$log_file"; then
    # The recorded origin can go stale if the Diff tab was last opened/
    # refreshed from a pane that has since closed (prefix+d stamps whichever
    # pane triggered it, not necessarily "the" agent). Fall back to this
    # workspace's one live agent, if there's exactly one to fall back to —
    # ambiguous with zero or several, so only self-heal the unambiguous case.
    mapfile -t candidates < <(
        herdr agent list |
            jq -r --arg ws "$workspace_id" \
                '.result.agents[] | select(.workspace_id == $ws) | .pane_id'
    )
    if [[ ${#candidates[@]} -eq 1 && "${candidates[0]}" != "$origin_pane_id" ]]; then
        origin_pane_id="${candidates[0]}"
        herdr agent prompt "$origin_pane_id" "$message"
        herdr pane report-metadata "$diff_pane_id" --source herdr-diff-tab --token "origin_pane=$origin_pane_id"
    else
        herdr notification show "Could not send comments" --body "Recorded conversation is gone; reopen the Diff tab with prefix+alt+d."
        exit 1
    fi
fi

# Sent successfully — clear these notes out of hunk so they don't get sent
# again the next time prefix+alt+c runs. By noteId rather than a blanket
# `comment clear`, so a note left after $comments_json was captured (while
# the send was in flight) survives instead of vanishing unsent.
for note_id in "${note_ids[@]}"; do
    if ! hunk session comment rm --repo "$cwd" "$note_id" >/dev/null 2>>"$log_file"; then
        echo "$(date -Is) failed to remove comment $note_id after sending" >>"$log_file"
    fi
done

noun="comment"
[[ "$count" -ne 1 ]] && noun="comments"
herdr notification show "Sent $count $noun" --body "to the conversation that opened this Diff tab."
